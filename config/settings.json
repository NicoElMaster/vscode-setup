{
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "vscode-icons",
    "workbench.productIconTheme": "fluent-icons",
    "workbench.activityBar.location": "top",
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,

    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', Consolas, Menlo, 'Droid Sans Mono', monospace",
    "editor.fontLigatures": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.guides.bracketPairs": "active",
    "editor.renderLineHighlight": "all",
    "editor.minimap.renderCharacters": false,
    "editor.stickyScroll.enabled": true,
    "workbench.list.smoothScrolling": true,

    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', Consolas, Menlo, monospace",
    "terminal.integrated.minimumContrastRatio": 1,
    "terminal.integrated.smoothScrolling": true,

    "vscode-pets.petType": "cat",
    "vscode-pets.petSize": "medium",
    "vscode-pets.position": "explorer",
    "vscode-pets.theme": "forest",
    "vscode-pets.throwBallWithMouse": true,

    "powermode.enabled": true,
    "powermode.presets": "particles",
    "powermode.shake.enabled": false
}
